<comment>
problem   = 1D radiation diffusion with a comoving spectrum, through the nurates source
reference = inputs/tests/rad_diffusiontest_nurates.athinput, plus frequency dependence

# The only test in the suite that has an absolute answer AND a shape factor S != 1, so
# the only one that can choose between the competing closure definitions documented in
# src/radiation/radiation_nurates.hpp.
#
# The comoving spectrum is a Gaussian in ln(E) sampled at bin midpoints, so ln(qbar) is
# exactly quadratic in the bin index; the log-space cubic in ShiftedBinValue reproduces
# it, and its shift by ln(n0_cm)/dlnnu, to roundoff.  The frequency machinery is exact by
# construction and the run measures the closure alone.
#
# With nurates_toy_scat_p = 0 the exact solution is separable: elastic scattering leaves
# the comoving spectrum alone, so the answer is w_bin(ifr, n0_cm) times the grey answer,
# and every group must show the same relative error as the grey run.  A closure that
# returns the wrong bin-mean intensity breaks that group by group.
#
# With nurates_toy_scat_p != 0 each comoving group diffuses with its own
# D(E) = 1/(3 sigma_s(E)), which is the physical version of the same question.
#
# Requires a build with -DAthena_ENABLE_NURATES=ON.

<job>
basename  = diffusion_spec

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.1
nlim       = -1
tlim       = 1.0
ndiag      = 2000

<coord>
general_rel = true
minkowski   = true

<mesh>
nghost = 2
nx1    = 128
x1min  = -1.0
x1max  = 2.0
ix1_bc = periodic
ox1_bc = periodic

nx2    = 1
x2min  = -0.5
x2max  = 0.5

nx3    = 1
x3min  = -0.5
x3max  = 0.5

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = hlle
gamma       = 2.0

<radiation>
nlevel                 = 3
radiation_type         = neutrino
nspecies               = 1
use_nurates            = true
nurates_toy_scattering = 100.0   # sigma_s; problem/kappa_s is taken from this
nurates_toy_scat_p     = 0.0     # sigma_s ~ (e_cm/eref)^p; 0 keeps the answer separable
nurates_toy_scat_eref  = 50.0    # MeV
fixed_fluid            = true
affect_fluid           = false
evolve_ye              = false
arad                   = 1.0
multi_freq  = true
nfreq       = 12
nu_min      = 1.0        # MeV
nu_max      = 3000.0     # MeV
freq_scale  = log
freq_fluxes = false

<problem>
pgen_name      = rad_m1_diffusiontest
initial_data   = diffusion
fluid_velocity = 0.3
kappa_s        = 100.0  # ignored on the nurates path; see nurates_toy_scattering
nu             = 4.0
t0             = 0.0
# Standard deviation of the comoving spectrum in units of dlnnu.  Wide enough that S
# spans decades, narrow enough that no ray loses the tail off either end of the grid --
# the pgen prints the worst ray-to-ray coverage error, which must stay at roundoff.
spec_width     = 1.3
spec_peak      = 0.0     # 0 = middle of the grid
