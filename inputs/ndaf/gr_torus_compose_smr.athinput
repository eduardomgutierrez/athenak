# AthenaK input: Fishbone-Moncrief torus, tabulated CompOSE EOS (SFHo), fluid only, with a
# negligible magnetic field.  The control run for inputs/ndaf/gr_torus_compose_nu_smr.athinput:
# the same mesh, torus and run length, without neutrinos.
#
# Field: the SANE vector potential is kept but normalised to potential_beta_min = 1e15, so
#   p_mag/p_gas ~ 1e-15.  There is no MRI and hence no turbulent accretion: the torus should
#   sit in equilibrium apart from the initial relaxation and the atmosphere's infall.  Any
#   heating or mass loss here is numerical, the baseline against which the neutrino run's
#   cooling and Ye evolution are read.
# Torus: M = 2.8 Msun, a = 0.8, r_in = 4 M, r_peak = 9 M, s = 4 kB, Ye = 0.1 (M_disk = 0.023
#   Msun; talk notes, section 19).
# Mesh: identical to the neutrino run.  64^3 root on [-64,64]^3 (dx = 2 M), 16^3 meshblocks,
#   SMR to dx = 1 / 0.5 / 0.25 M in |x|,|y| < 64/32/16 and |z| < 32/16/8; 736 meshblocks,
#   3.0e6 cells.  dt = 0.075 M, 6700 cycles to t = 500 M.
# Memory: fluid only, ~4 kB per cell -> ~12 GB: one Aurora node (or fewer tiles).
# Build: -D PROBLEM=gr_torus_compose (nurates not needed).
# Table: set mhd/table on the command line to the cluster path of SFHo.athtable.

<comment>
problem   = FM torus, SFHo, fluid only, negligible field (control for the neutrino run)

<job>
basename  = torus_smr

<mesh>
nghost = 4        # ppm4 reconstruction needs 4 ghost zones
nx1    = 64
x1min  = -64.0
x1max  = 64.0
ix1_bc = user     # NoInflowTorus for the fluid; vacuum/outflow for the radiation
ox1_bc = user

nx2    = 64
x2min  = -64.0
x2max  = 64.0
ix2_bc = user
ox2_bc = user

nx3    = 64
x3min  = -64.0
x3max  = 64.0
ix3_bc = user
ox3_bc = user

<meshblock>
nx1    = 16
nx2    = 16
nx3    = 16

<mesh_refinement>
refinement = static

<refined_region>
level = 1         # dx = 1 M
x1min = -64.0
x1max = 64.0
x2min = -64.0
x2max = 64.0
x3min = -32.0
x3max = 32.0

<refined_region>
level = 2         # dx = 0.5 M
x1min = -32.0
x1max = 32.0
x2min = -32.0
x2max = 32.0
x3min = -16.0
x3max = 16.0

<refined_region>
level = 3         # dx = 0.25 M: the torus and the hole
x1min = -16.0
x1max = 16.0
x2min = -16.0
x2max = 16.0
x3min = -8.0
x3max = 8.0

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = -1
tlim       = 500.0
ndiag      = 20

<coord>
general_rel = true       # general relativity
a           = 0.8        # black hole spin a (0 <= a/M < 1)
excise      = true       # excise r_ks <= 1.0
dexcise     = 3.0e-15    # density inside excision
texcise     = 1.0        # temperature [MeV] inside excision; required once <adm> makes
                          # this a dynamical-relativistic run (coordinates.cpp reads
                          # texcise, not pexcise, in that case)

<mhd>
eos         = ideal      # unused: dyn_eos selects the real (tabulated) EOS
dyn_eos     = compose
dyn_error   = reset_floor
reconstruct = ppm4       # spatial reconstruction method
rsolver     = hlle       # Riemann solver
dfloor      = 3.0e-15    # floor on density rho
pfloor      = 0.333e-12  # floor on gas pressure p_gas
tfloor      = 0.333e-12
gamma       = 1.3333333333333333  # unused with dyn_eos=compose
fofc        = true       # first-order flux correction
gamma_max   = 20.0       # ceiling on Lorentz factor
dyn_scratch = 0
s0_atmosphere = 0.5
c2p_tol     = 2.49e-13
enforce_maximum = false
dmp_M       = 1.2
nscalars    = 1          # Ye

table       = /home/emgutierrez/work/athenak/tables/SFHo.athtable
units       = geometric_mass
M_Msun      = 2.8        # EOS mass unit; the pgen defaults problem/M_Msun to match this

<adm>

<problem>
fm_torus   = true
chakrabarti_torus = false
sane       = true
r_edge     = 4
r_peak     = 9
tilt_angle = 0.0
potential_beta_min = 1e15  # p_gas/p_mag at the maximum: negligible field, no MRI
potential_cutoff   = 0.2
rho_min   = 3.0e-12
rho_pow   = -1.5
pgas_min  = 0.333e-14
pgas_pow  = -2.5
rho_max   = 1.0
l         = 0.0
pert_amp  = 0.0
user_hist = true
s_0_param       = 4.0
s_bar = 0.0
Ye_0_param = 0.1
Ye_bar = 0.0

<output1>
file_type = hst                # mass, energy and angular-momentum fluxes at r = 3, 12, 24 M
dt        = 5.0
user_hist_only = true

<output2>
file_type = bin                # matter, 3D
variable  = mhd_w_bcc
dt        = 10.0

<output3>
file_type = bin                # matter, x-z plane, more often
id        = mhd_w_bcc_xz
variable  = mhd_w_bcc
dt        = 2.0
slice_x2  = 0.0

<output4>
file_type = rst
dt        = 50.0
