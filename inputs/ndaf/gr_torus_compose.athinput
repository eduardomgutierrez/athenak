# AthenaK input: Fishbone-Moncrief torus, tabulated CompOSE EOS (SFHo), fluid-only (no
# radiation). This is a local sizing/design run for the NDAF project (ndaf-multifreq
# roadmap step 5-6): same torus physics as the production input
# (the production input on Aurora: r_edge=4, r_peak=9, a=0.8), but a coarser mesh so a build
# and a 200M run fit comfortably in 24 cores / 15 GB on this workstation.
#
# Resolution: base mesh 64^3 on [-64,64]^3 (dx=2M), meshblock 16^3 (4x4x4=64 blocks),
# two levels of static mesh refinement doubling resolution each time:
#   level 1: [-32,32]^3, dx=1M
#   level 2: [-16,16]^3, dx=0.5M  (finest zone at the horizon, matches the production
#                                  8M/M-at-horizon target divided by 4 for this cheap run)
#
# Mass unit: mhd/units=geometric_mass with mhd/M_Msun=2.8 sets the code-to-cgs mass/length
# scale the CompOSE table is read in (M = 2.8 Msun, appropriate for the NDAF remnant this
# project targets). The pgen (src/pgen/gr_torus_compose.cpp, SyncTorusUnitsWithEOS) reads
# this from <mhd> and defaults problem/M_Msun to match; it aborts if the two disagree, so
# do not also set M_Msun under <problem>.
#
# Boundaries: all six faces use the pgen's NoInflowTorus ("user") outflow/no-inflow BC.
#
# Build:  cmake -B build-torus-omp -DCMAKE_BUILD_TYPE=Release -D Athena_ENABLE_NURATES=ON \
#           -D PROBLEM=gr_torus_compose -D Kokkos_ENABLE_OPENMP=ON
#         cmake --build build-torus-omp -j20
# Run:    OMP_NUM_THREADS=20 OMP_PROC_BIND=spread OMP_PLACES=threads \
#           ./build-torus-omp/src/athena -i inputs/ndaf/gr_torus_compose.athinput -d <rundir>
# GPU:    cmake -B build-torus-cuda -DCMAKE_BUILD_TYPE=Release -D Athena_ENABLE_NURATES=ON \
#           -D PROBLEM=gr_torus_compose -D Kokkos_ENABLE_CUDA=ON -D Kokkos_ARCH_BLACKWELL120=ON \
#           -D CMAKE_CXX_COMPILER=$PWD/kokkos/bin/nvcc_wrapper
# Cost:   t = 200 takes ~400 s on an RTX 5070 Ti laptop GPU (0.3 s/cycle); ~4x slower on 16
#         OpenMP threads.  The GPU and CPU runs agree to round-off.
#
# Table:  /home/emgutierrez/work/athenak/tables/SFHo.athtable (full SFHo table with Y_p/Y_n)

<comment>
problem   = Fishbone-Moncrief torus, tabulated CompOSE EOS (SFHo), fluid-only design run

<job>
basename  = torus_design

<mesh>
nghost = 4        # ppm4 reconstruction needs 4 ghost zones
nx1    = 64       # number of cells in x1-direction
x1min  = -64.0    # minimum x1 [M]
x1max  = 64.0     # maximum x1 [M]
ix1_bc = user     # NoInflowTorus (vacuum, no-inflow outer BC)
ox1_bc = user

nx2    = 64       # number of cells in x2-direction
x2min  = -64.0
x2max  = 64.0
ix2_bc = user
ox2_bc = user

nx3    = 64       # number of cells in x3-direction
x3min  = -64.0
x3max  = 64.0
ix3_bc = user
ox3_bc = user

<meshblock>
nx1  = 16         # Number of cells in each MeshBlock, X1-dir
nx2  = 16         # Number of cells in each MeshBlock, X2-dir
nx3  = 16         # Number of cells in each MeshBlock, X3-dir

<mesh_refinement>
refinement = static    # type of refinement

<refined_region>
level = 1
x1min = -32.0
x1max = 32.0
x2min = -32.0
x2max = 32.0
x3min = -32.0
x3max = 32.0

<refined_region>
level = 2
x1min = -16.0
x1max = 16.0
x2min = -16.0
x2max = 16.0
x3min = -16.0
x3max = 16.0

<time>
evolution  = dynamic     # dynamic/kinematic/static
integrator = rk2         # time integration algorithm
cfl_number = 0.3         # Courant number
nlim       = -1          # cycle limit (unused; tlim stops the run)
tlim       = 200.0       # time limit [M]; production run (aurora_torus.par) uses tlim=3000 on Aurora
ndiag      = 1           # cycles between diagnostic stdout lines

<coord>
general_rel = true       # general relativity
a           = 0.8        # black hole spin a (0 <= a/M < 1)
excise      = true       # excise r_ks <= 1.0
dexcise     = 3.0e-15    # density inside excision
texcise     = 1.0        # temperature [MeV] inside excision; required once <adm> makes
                          # this a dynamical-relativistic run (coordinates.cpp reads
                          # texcise, not pexcise, in that case)

<mhd>
eos         = ideal      # unused: dyn_eos selects the real (tabulated) EOS
dyn_eos     = compose
dyn_error   = reset_floor
reconstruct = ppm4       # spatial reconstruction method
rsolver     = hlle       # Riemann solver
dfloor      = 3.0e-15    # floor on density rho
pfloor      = 0.333e-12  # floor on gas pressure p_gas
tfloor      = 0.333e-12
gamma       = 1.3333333333333333  # unused with dyn_eos=compose
fofc        = true       # first-order flux correction
gamma_max   = 20.0       # ceiling on Lorentz factor
dyn_scratch = 0
s0_atmosphere = 0.5
c2p_tol     = 2.49e-13
enforce_maximum = false
dmp_M       = 1.2
nscalars    = 1          # Ye

table       = /home/emgutierrez/work/athenak/tables/SFHo.athtable
units       = geometric_mass
M_Msun      = 2.8        # EOS mass unit; the pgen defaults problem/M_Msun to match this

<adm>

<problem>
fm_torus   = true  # Fishbone & Moncrief
chakrabarti_torus = false
sane       = true  # vector potential for magnetic field (SANE or MAD config.)
r_edge     = 4     # radius of inner edge of disk
r_peak     = 9     # radius of pressure maximum; use l instead if negative
tilt_angle = 0.0   # angle (deg) to incl disk spin axis relative to BH spin in dir of x
potential_beta_min = 1e15  # ratio of gas to magnetic pressure at maxima (effectively hydro)
# potential_beta_min = 100  # SANE magnetized run
potential_cutoff   = 0.2    # amount to subtract from density when calculating potential
rho_min   = 3.0e-12   # background on rho given by rho_min ...
rho_pow   = -1.5      # ... * r^rho_pow
pgas_min  = 0.333e-14 # background on p_gas given by pgas_min ...
pgas_pow  = -2.5      # ... * r^pgas_pow
rho_max   = 1.0       # if > 0, rescale rho to have this peak; rescale pres by same factor
l         = 0.0       # const ang. mom. per unit mass u^t u_phi; only used if r_peak < 0
pert_amp  = 0.0       # perturbation amplitude
user_hist = true      # enroll user-defined history function
s_0_param       = 4.0
s_bar = 0.0
Ye_0_param = 0.1
Ye_bar = 0.0

<output1>
file_type  = hst        # History output
dt         = 5.0        # time increment between outputs
user_hist_only = true   # only output user-defined history

<output2>
file_type  = bin        # Binary data dump
id         = mhd_w_bcc_xz
variable   = mhd_w_bcc  # variables to be output (includes 'temperature' via pdyngr)
dt         = 10.0       # time increment between outputs
slice_x2   = 0.0

<output3>
file_type  = bin        # Binary data dump
id         = mhd_w_bcc_xy
variable   = mhd_w_bcc
dt         = 10.0
slice_x3   = 0.0

<output4>
file_type  = rst
dt         = 100.0
